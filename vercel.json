{
  "rewrites": [
    { "source": "/api/:action", "destination": "/api/index?action=:action" },
    { "source": "/api/:action/:sub*", "destination": "/api/index?action=:action&sub=:sub*" },

    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/index?action=prices&sub=refresh&secret=@cron_secret",
      "schedule": "10 6 * * 1-5"
    }
  ]
}
