{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/prices/refresh?secret=@cron_secret",
      "schedule": "10 6 * * 1-5"
    }
  ]
}

